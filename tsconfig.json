{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "noEmit": true,
    "skipLibCheck": false,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx"
  },
  "include": [
    "server.ts",
    "usage.ts",
    "usage.test.ts",
    "thread-costs.ts",
    "thread-costs.test.ts",
    "cost-tracker.ts",
    "contract.ts",
    "host.ts",
    "app.tsx",
    "cost-tracker.test.ts"
  ]
}
